{
  "$schema": "https://www.unpkg.com/wrangler/config-schema.json",
  "name": "hopp",
  "main": "./worker.js",
  "compatibility_date": "2026-11-06",
  "workers_dev": false,
  "routes": [
    { "pattern": "hopp.lightly.dev", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/assets/*.mp4"]
  }
}
